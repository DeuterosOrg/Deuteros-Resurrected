layout_mode = 2
theme_type_variation = &"DescLabel"
text = "Apply your changes before closing, or discard them?"
autowrap_mode = 3

[node name="ConfirmButtons" type="HBoxContainer" parent="ConfirmOverlay/ConfirmCenter/ConfirmPanel/ConfirmVBox"]
