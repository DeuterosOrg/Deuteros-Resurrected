[node name="BuildTitanStationRow" parent="Margin/Layout/Body/MainColumn/SettingsPanel/SettingsVBox/SettingsScroll/ListMargin/DebugList" instance=ExtResource("action")]
unique_name_in_owner = true
layout_mode = 2
