layout_mode = 2
theme_type_variation = &"FramePanel"

[node name="ConfirmVBox" type="VBoxContainer" parent="ConfirmOverlay/ConfirmCenter/ConfirmPanel"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="ConfirmTitle" type="Label" parent="ConfirmOverlay/ConfirmCenter/ConfirmPanel/ConfirmVBox"]
