[node name="EarthStationTo7Row" parent="Margin/Layout/Body/MainColumn/SettingsPanel/SettingsVBox/SettingsScroll/ListMargin/DebugList" instance=ExtResource("action")]
unique_name_in_owner = true
layout_mode = 2
LabelText = "Earth Station to 7"
Description = "Builds Earth's station to 7 parts, researching the ACC and stocking a supply pod and ACC if needed. Also runs Skip To Shuttles if shuttles aren't unlocked."

[node name="EarthOrbitProductionRow" parent="Margin/Layout/Body/MainColumn/SettingsPanel/SettingsVBox/SettingsScroll/ListMargin/DebugList" instance=ExtResource("action")]
unique_name_in_owner = true
layout_mode = 2
LabelText = "Prod. in Earth Orbit"
Description = "Completes Earth's station with an AOC factory and unlocks space stations. Runs Earth Station to 7 first if the station has fewer than 7 parts."

[node name="IOSModulesReadyRow" parent="Margin/Layout/Body/MainColumn/SettingsPanel/SettingsVBox/SettingsScroll/ListMargin/DebugList" instance=ExtResource("action")]
unique_name_in_owner = true
layout_mode = 2
LabelText = "IOS Modules Ready"
Description = "Unlocks IOS attachments and researches the AMA, AOC, Bandaid, Grapple and R-Frame. Completes Earth's station first if it isn't built."

[node name="ActivateMTXRow" parent="Margin/Layout/Body/MainColumn/SettingsPanel/SettingsVBox/SettingsScroll/ListMargin/DebugList" instance=ExtResource("action")]
unique_name_in_owner = true
layout_mode = 2
LabelText = "Activate MTX"
