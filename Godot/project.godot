; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Deuteros"
run/main_scene="res://Screens/Master.tscn"
config/features=PackedStringArray("4.2", "C#", "Forward Plus")
run/flush_stdout_on_print=true
config/icon="res://icon.png"

[autoload]

OverlayManager="*res://Code/Platform/Helpers/OverlayManager.cs"

[debug]

settings/stdout/verbose_stdout=true

[display]

window/size/viewport_width=320
window/size/viewport_height=200
window/stretch/mode="viewport"
window/stretch/scale_mode="integer"
window/main_scene="res://Screens/Master.tscn"

[dotnet]

project/assembly_name="Deuteros"

[editor]

; Godot 4.2.1 binary conversion leaks scene instances during fresh exports.
export/convert_text_resources_to_binary=false

[editor_plugins]

enabled=PackedStringArray("res://addons/validation_import/plugin.cfg")

[filesystem]

import/blender/enabled=false

[gui]

theme/custom="res://Themes/DefaultTheme.tres"
theme/custom_font="res://Fonts/deuteros.ttf"
theme/default_font_antialiasing=0

[logging]

file_logging/enable_file_logging=true

[mono]

debugger_agent/wait_timeout=15000

[rendering]

textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
environment/defaults/default_environment="res://default_env.tres"
